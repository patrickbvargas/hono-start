generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ClerkWebhookReceipt {
  id          String   @id
  processedAt DateTime @default(now())

  @@map("clerk_webhook_receipts")
}

model Firm {
  id                       Int                       @id @default(autoincrement())
  name                     String
  remunerationCutoffDay    Int                       @default(25)
  remunerationDueDay       Int                       @default(5)
  contracts                Contract[]                @relation("Contract_firmId")
  contractAssignments      ContractAssignment[]      @relation("ContractAssignment_firmId")
  revenues                 Revenue[]                 @relation("Revenue_firmId")
  expenses                 Expense[]                 @relation("Expense_firmId")
  financialGenerations     FinancialGeneration[]     @relation("FinancialGeneration_firmId")
  directFinancialEntries   DirectFinancialEntry[]    @relation("DirectFinancialEntry_firmId")
  receivables              Receivable[]              @relation("Receivable_firmId")
  payables                 Payable[]                 @relation("Payable_firmId")
  receipts                 Receipt[]                 @relation("Receipt_firmId")
  receiptReversals         ReceiptReversal[]         @relation("ReceiptReversal_firmId")
  payments                 Payment[]                 @relation("Payment_firmId")
  paymentReversals         PaymentReversal[]         @relation("PaymentReversal_firmId")
  remunerationCalculations RemunerationCalculation[] @relation("RemunerationCalculation_firmId")
  attachments              Attachment[]              @relation("Attachment_firmId")
  auditLogs                AuditLog[]                @relation("AuditLog_firmId")

  @@map("firms")
}

model PersonType {
  id       Int      @id @default(autoincrement())
  value    String   @unique
  label    String
  isActive Boolean  @default(true)
  people   Person[] @relation("Person_personTypeId")

  @@map("ref_person_types")
}

model EmployeeType {
  id       Int               @id @default(autoincrement())
  value    String            @unique
  label    String
  isActive Boolean           @default(true)
  profiles EmployeeProfile[] @relation("EmployeeProfile_employeeTypeId")

  @@map("ref_employee_types")
}

model LegalArea {
  id        Int        @id @default(autoincrement())
  value     String     @unique
  label     String
  isActive  Boolean    @default(true)
  contracts Contract[] @relation("Contract_legalAreaId")

  @@map("ref_legal_areas")
}

model ContractStatus {
  id        Int        @id @default(autoincrement())
  value     String     @unique
  label     String
  isActive  Boolean    @default(true)
  contracts Contract[] @relation("Contract_statusId")

  @@map("ref_contract_statuses")
}

model AssignmentType {
  id          Int                  @id @default(autoincrement())
  value       String               @unique
  label       String
  isActive    Boolean              @default(true)
  assignments ContractAssignment[] @relation("ContractAssignment_assignmentTypeId")

  @@map("ref_assignment_types")
}

model RevenueType {
  id       Int       @id @default(autoincrement())
  value    String    @unique
  label    String
  isActive Boolean   @default(true)
  revenues Revenue[] @relation("Revenue_revenueTypeId")

  @@map("ref_revenue_types")
}

model AttachmentType {
  id          Int          @id @default(autoincrement())
  value       String       @unique
  label       String
  isActive    Boolean      @default(true)
  attachments Attachment[] @relation("Attachment_typeId")

  @@map("ref_attachment_types")
}

model FinancialAnalytic {
  id          Int          @id @default(autoincrement())
  value       String       @unique
  label       String
  isActive    Boolean      @default(true)
  receivables Receivable[] @relation("Receivable_analyticId")
  payables    Payable[]    @relation("Payable_analyticId")

  @@map("ref_financial_analytics")
}

model PaymentMethod {
  id          Int          @id @default(autoincrement())
  value       String       @unique
  label       String
  isActive    Boolean      @default(true)
  receivables Receivable[] @relation("Receivable_expectedPaymentMethodId")
  payables    Payable[]    @relation("Payable_expectedPaymentMethodId")
  receipts    Receipt[]    @relation("Receipt_actualPaymentMethodId")
  payments    Payment[]    @relation("Payment_actualPaymentMethodId")

  @@map("ref_payment_methods")
}

model TitleKind {
  id          Int          @id @default(autoincrement())
  value       String       @unique
  label       String
  isActive    Boolean      @default(true)
  receivables Receivable[] @relation("Receivable_titleKindId")
  payables    Payable[]    @relation("Payable_titleKindId")

  @@map("ref_title_kinds")
}

model Person {
  id                Int                    @id @default(autoincrement())
  fullName          String
  document          String                 @unique
  email             String?
  phone             String?
  isCustomer        Boolean                @default(false)
  isSupplier        Boolean                @default(false)
  isEmployee        Boolean                @default(false)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  personTypeId      Int
  personType        PersonType             @relation("Person_personTypeId", fields: [personTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employeeProfile   EmployeeProfile?       @relation("EmployeeProfile_personId")
  customerContracts Contract[]             @relation("Contract_customerId")
  expenses          Expense[]              @relation("Expense_supplierId")
  generations       FinancialGeneration[]  @relation("FinancialGeneration_actorId")
  directEntries     DirectFinancialEntry[] @relation("DirectFinancialEntry_actorId")
  receivables       Receivable[]           @relation("Receivable_debtorId")
  payables          Payable[]              @relation("Payable_beneficiaryId")
  receipts          Receipt[]              @relation("Receipt_actorId")
  receiptsReversed  ReceiptReversal[]      @relation("ReceiptReversal_actorId")
  payments          Payment[]              @relation("Payment_actorId")
  paymentsReversed  PaymentReversal[]      @relation("PaymentReversal_actorId")
  attachments       Attachment[]           @relation("Attachment_personId")
  actedAuditLogs    AuditLog[]             @relation("AuditLog_actorId")
  auditLogs         AuditLog[]             @relation("AuditLog_personId")

  @@index([fullName, id])
  @@index([deletedAt])
  @@index([personTypeId])
  @@map("people")
}

model EmployeeProfile {
  id                     Int                  @id @default(autoincrement())
  oabNumber              String?              @unique
  remunerationPercentage Decimal              @db.Decimal(5, 4)
  referralPercentage     Decimal              @db.Decimal(5, 4)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  personId               Int
  person                 Person               @relation("EmployeeProfile_personId", fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employeeTypeId         Int
  employeeType           EmployeeType         @relation("EmployeeProfile_employeeTypeId", fields: [employeeTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments            ContractAssignment[] @relation("ContractAssignment_employeeProfileId")

  @@unique([personId])
  @@index([personId])
  @@index([employeeTypeId])
  @@map("employee_profiles")
}

model Contract {
  id                Int                  @id @default(autoincrement())
  processNumber     String
  feePercentage     Decimal              @db.Decimal(5, 4)
  notes             String?
  allowStatusChange Boolean              @default(true)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  firmId            Int
  firm              Firm                 @relation("Contract_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId        Int
  customer          Person               @relation("Contract_customerId", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  legalAreaId       Int
  legalArea         LegalArea            @relation("Contract_legalAreaId", fields: [legalAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusId          Int
  status            ContractStatus       @relation("Contract_statusId", fields: [statusId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments       ContractAssignment[] @relation("ContractAssignment_contractId")
  revenues          Revenue[]            @relation("Revenue_contractId")
  attachments       Attachment[]         @relation("Attachment_contractId")
  auditLogs         AuditLog[]           @relation("AuditLog_contractId")

  @@unique([firmId, id])
  @@unique([firmId, processNumber])
  @@index([firmId])
  @@index([customerId])
  @@index([legalAreaId])
  @@index([statusId])
  @@map("contracts")
}

model ContractAssignment {
  id                Int                       @id @default(autoincrement())
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  firmId            Int
  firm              Firm                      @relation("ContractAssignment_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contractId        Int
  contract          Contract                  @relation("ContractAssignment_contractId", fields: [firmId, contractId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  employeeProfileId Int
  employeeProfile   EmployeeProfile           @relation("ContractAssignment_employeeProfileId", fields: [employeeProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignmentTypeId  Int
  assignmentType    AssignmentType            @relation("ContractAssignment_assignmentTypeId", fields: [assignmentTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  calculations      RemunerationCalculation[] @relation("RemunerationCalculation_contractAssignmentId")

  @@unique([firmId, id])
  @@unique([contractId, employeeProfileId, assignmentTypeId])
  @@index([firmId])
  @@index([contractId])
  @@index([employeeProfileId])
  @@index([assignmentTypeId])
  @@map("contract_assignments")
}

model Revenue {
  id               Int                  @id @default(autoincrement())
  negotiatedAmount Decimal              @db.Decimal(14, 2)
  notes            String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  firmId           Int
  firm             Firm                 @relation("Revenue_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contractId       Int
  contract         Contract             @relation("Revenue_contractId", fields: [firmId, contractId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  revenueTypeId    Int
  revenueType      RevenueType          @relation("Revenue_revenueTypeId", fields: [revenueTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generation       FinancialGeneration? @relation("FinancialGeneration_revenueId")
  receivables      Receivable[]         @relation("Receivable_revenueId")

  @@unique([firmId, id])
  @@index([firmId])
  @@index([contractId])
  @@index([revenueTypeId])
  @@map("revenues")
}

model Expense {
  id               Int                  @id @default(autoincrement())
  negotiatedAmount Decimal              @db.Decimal(14, 2)
  notes            String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  firmId           Int
  firm             Firm                 @relation("Expense_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierId       Int
  supplier         Person               @relation("Expense_supplierId", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generation       FinancialGeneration? @relation("FinancialGeneration_expenseId")
  payables         Payable[]            @relation("Payable_expenseId")
  attachments      Attachment[]         @relation("Attachment_expenseId")
  auditLogs        AuditLog[]           @relation("AuditLog_expenseId")

  @@unique([firmId, id])
  @@index([firmId])
  @@index([supplierId])
  @@map("expenses")
}

model FinancialGeneration {
  id           Int          @id @default(autoincrement())
  requestKey   String       @unique
  agreedAmount Decimal      @db.Decimal(14, 2)
  createdAt    DateTime     @default(now())
  firmId       Int
  firm         Firm         @relation("FinancialGeneration_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revenueId    Int?
  revenue      Revenue?     @relation("FinancialGeneration_revenueId", fields: [firmId, revenueId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  expenseId    Int?
  expense      Expense?     @relation("FinancialGeneration_expenseId", fields: [firmId, expenseId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  actorId      Int
  actor        Person       @relation("FinancialGeneration_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivables  Receivable[] @relation("Receivable_generationId")
  payables     Payable[]    @relation("Payable_generationId")
  auditLogs    AuditLog[]   @relation("AuditLog_financialGenerationId")

  @@unique([firmId, id])
  @@unique([revenueId])
  @@unique([expenseId])
  @@unique([firmId, revenueId])
  @@unique([firmId, expenseId])
  @@index([firmId])
  @@index([revenueId])
  @@index([expenseId])
  @@index([actorId])
  @@map("financial_generations")
}

model DirectFinancialEntry {
  id          Int          @id @default(autoincrement())
  reason      String
  createdAt   DateTime     @default(now())
  firmId      Int
  firm        Firm         @relation("DirectFinancialEntry_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorId     Int
  actor       Person       @relation("DirectFinancialEntry_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivables Receivable[] @relation("Receivable_directEntryId")
  payables    Payable[]    @relation("Payable_directEntryId")

  @@unique([firmId, id])
  @@index([firmId])
  @@index([actorId])
  @@map("direct_financial_entries")
}

model Receivable {
  id                      Int                   @id @default(autoincrement())
  amount                  Decimal               @db.Decimal(14, 2)
  dueDate                 DateTime              @db.Date
  notes                   String?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  firmId                  Int
  firm                    Firm                  @relation("Receivable_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  debtorId                Int
  debtor                  Person                @relation("Receivable_debtorId", fields: [debtorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  analyticId              Int
  analytic                FinancialAnalytic     @relation("Receivable_analyticId", fields: [analyticId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expectedPaymentMethodId Int
  expectedPaymentMethod   PaymentMethod         @relation("Receivable_expectedPaymentMethodId", fields: [expectedPaymentMethodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  titleKindId             Int
  titleKind               TitleKind             @relation("Receivable_titleKindId", fields: [titleKindId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generationId            Int?
  generation              FinancialGeneration?  @relation("Receivable_generationId", fields: [firmId, generationId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  directEntryId           Int?
  directEntry             DirectFinancialEntry? @relation("Receivable_directEntryId", fields: [firmId, directEntryId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  revenueId               Int?
  revenue                 Revenue?              @relation("Receivable_revenueId", fields: [firmId, revenueId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  receipts                Receipt[]             @relation("Receipt_receivableId")
  attachments             Attachment[]          @relation("Attachment_receivableId")
  auditLogs               AuditLog[]            @relation("AuditLog_receivableId")

  @@unique([firmId, id])
  @@index([firmId, dueDate, id])
  @@index([firmId])
  @@index([debtorId])
  @@index([analyticId])
  @@index([expectedPaymentMethodId])
  @@index([titleKindId])
  @@index([generationId])
  @@index([directEntryId])
  @@index([revenueId])
  @@map("receivables")
}

model Payable {
  id                        Int                      @id @default(autoincrement())
  amount                    Decimal                  @db.Decimal(14, 2)
  dueDate                   DateTime                 @db.Date
  notes                     String?
  cancelledAt               DateTime?
  cancellationReason        String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  firmId                    Int
  firm                      Firm                     @relation("Payable_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  beneficiaryId             Int
  beneficiary               Person                   @relation("Payable_beneficiaryId", fields: [beneficiaryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  analyticId                Int
  analytic                  FinancialAnalytic        @relation("Payable_analyticId", fields: [analyticId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expectedPaymentMethodId   Int
  expectedPaymentMethod     PaymentMethod            @relation("Payable_expectedPaymentMethodId", fields: [expectedPaymentMethodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  titleKindId               Int
  titleKind                 TitleKind                @relation("Payable_titleKindId", fields: [titleKindId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generationId              Int?
  generation                FinancialGeneration?     @relation("Payable_generationId", fields: [firmId, generationId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  directEntryId             Int?
  directEntry               DirectFinancialEntry?    @relation("Payable_directEntryId", fields: [firmId, directEntryId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  expenseId                 Int?
  expense                   Expense?                 @relation("Payable_expenseId", fields: [firmId, expenseId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  payments                  Payment[]                @relation("Payment_payableId")
  remunerationCalculationId Int?
  remunerationCalculation   RemunerationCalculation? @relation("Payable_remunerationCalculationId", fields: [firmId, remunerationCalculationId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  attachments               Attachment[]             @relation("Attachment_payableId")
  auditLogs                 AuditLog[]               @relation("AuditLog_payableId")

  @@unique([firmId, id])
  @@unique([remunerationCalculationId])
  @@unique([firmId, remunerationCalculationId])
  @@index([firmId, dueDate, id])
  @@index([firmId])
  @@index([beneficiaryId])
  @@index([analyticId])
  @@index([expectedPaymentMethodId])
  @@index([titleKindId])
  @@index([generationId])
  @@index([directEntryId])
  @@index([expenseId])
  @@index([remunerationCalculationId])
  @@map("payables")
}

model Receipt {
  id                    Int                       @id @default(autoincrement())
  effectiveDate         DateTime                  @db.Date
  principalAbated       Decimal                   @db.Decimal(14, 2)
  discount              Decimal                   @default(0) @db.Decimal(14, 2)
  interest              Decimal                   @default(0) @db.Decimal(14, 2)
  penalty               Decimal                   @default(0) @db.Decimal(14, 2)
  effectiveAmount       Decimal                   @db.Decimal(14, 2)
  reason                String?
  requestKey            String
  generatesRemuneration Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  firmId                Int
  firm                  Firm                      @relation("Receipt_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivableId          Int
  receivable            Receivable                @relation("Receipt_receivableId", fields: [firmId, receivableId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  actualPaymentMethodId Int
  actualPaymentMethod   PaymentMethod             @relation("Receipt_actualPaymentMethodId", fields: [actualPaymentMethodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorId               Int
  actor                 Person                    @relation("Receipt_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversal              ReceiptReversal?          @relation("ReceiptReversal_receiptId")
  calculations          RemunerationCalculation[] @relation("RemunerationCalculation_receiptId")
  attachments           Attachment[]              @relation("Attachment_receiptId")
  auditLogs             AuditLog[]                @relation("AuditLog_receiptId")

  @@unique([firmId, id])
  @@unique([firmId, requestKey, receivableId])
  @@index([firmId, effectiveDate, id])
  @@index([firmId])
  @@index([receivableId])
  @@index([actualPaymentMethodId])
  @@index([actorId])
  @@map("receipts")
}

model ReceiptReversal {
  id            Int      @id @default(autoincrement())
  effectiveDate DateTime @db.Date
  reason        String
  requestKey    String   @unique
  createdAt     DateTime @default(now())
  firmId        Int
  firm          Firm     @relation("ReceiptReversal_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receiptId     Int
  receipt       Receipt  @relation("ReceiptReversal_receiptId", fields: [firmId, receiptId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  actorId       Int
  actor         Person   @relation("ReceiptReversal_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([firmId, id])
  @@unique([receiptId])
  @@unique([firmId, receiptId])
  @@index([firmId])
  @@index([receiptId])
  @@index([actorId])
  @@map("receipt_reversals")
}

model Payment {
  id              Int      @id @default(autoincrement())
  effectiveDate   DateTime @db.Date
  principalAbated Decimal  @db.Decimal(14, 2)
  discount        Decimal  @default(0) @db.Decimal(14, 2)
  interest        Decimal  @default(0) @db.Decimal(14, 2)
  penalty         Decimal  @default(0) @db.Decimal(14, 2)
  effectiveAmount Decimal  @db.Decimal(14, 2)
  reason          String?
  requestKey      String

  createdAt             DateTime         @default(now())
  firmId                Int
  firm                  Firm             @relation("Payment_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payableId             Int
  payable               Payable          @relation("Payment_payableId", fields: [firmId, payableId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  actualPaymentMethodId Int
  actualPaymentMethod   PaymentMethod    @relation("Payment_actualPaymentMethodId", fields: [actualPaymentMethodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorId               Int
  actor                 Person           @relation("Payment_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversal              PaymentReversal? @relation("PaymentReversal_paymentId")
  attachments           Attachment[]     @relation("Attachment_paymentId")
  auditLogs             AuditLog[]       @relation("AuditLog_paymentId")

  @@unique([firmId, id])
  @@unique([firmId, requestKey, payableId])
  @@index([firmId, effectiveDate, id])
  @@index([firmId])
  @@index([payableId])
  @@index([actualPaymentMethodId])
  @@index([actorId])
  @@map("payments")
}

model PaymentReversal {
  id            Int      @id @default(autoincrement())
  effectiveDate DateTime @db.Date
  reason        String
  requestKey    String   @unique
  createdAt     DateTime @default(now())
  firmId        Int
  firm          Firm     @relation("PaymentReversal_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentId     Int
  payment       Payment  @relation("PaymentReversal_paymentId", fields: [firmId, paymentId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  actorId       Int
  actor         Person   @relation("PaymentReversal_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([firmId, id])
  @@unique([paymentId])
  @@unique([firmId, paymentId])
  @@index([firmId])
  @@index([paymentId])
  @@index([actorId])
  @@map("payment_reversals")
}

model RemunerationCalculation {
  id                   Int                @id @default(autoincrement())
  calculationBase      Decimal            @db.Decimal(14, 2)
  effectivePercentage  Decimal            @db.Decimal(5, 4)
  calculatedAmount     Decimal            @db.Decimal(14, 2)
  computedDueDate      DateTime           @db.Date
  generationMode       String             @default("AUTOMATIC")
  ruleSnapshot         Json
  createdAt            DateTime           @default(now())
  firmId               Int
  firm                 Firm               @relation("RemunerationCalculation_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receiptId            Int
  receipt              Receipt            @relation("RemunerationCalculation_receiptId", fields: [firmId, receiptId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  contractAssignmentId Int
  contractAssignment   ContractAssignment @relation("RemunerationCalculation_contractAssignmentId", fields: [firmId, contractAssignmentId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  payable              Payable?           @relation("Payable_remunerationCalculationId")
  attachments          Attachment[]       @relation("Attachment_remunerationCalculationId")
  auditLogs            AuditLog[]         @relation("AuditLog_remunerationCalculationId")

  @@unique([firmId, id])
  @@unique([receiptId, contractAssignmentId])
  @@index([firmId])
  @@index([receiptId])
  @@index([contractAssignmentId])
  @@map("remuneration_calculations")
}

model Attachment {
  id                        Int                      @id @default(autoincrement())
  fileName                  String
  storagePath               String                   @unique
  mimeType                  String
  fileSize                  Int
  isActive                  Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  deletedAt                 DateTime?
  firmId                    Int
  firm                      Firm                     @relation("Attachment_firmId", fields: [firmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  typeId                    Int
  type                      AttachmentType           @relation("Attachment_typeId", fields: [typeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  personId                  Int?
  person                    Person?                  @relation("Attachment_personId", fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contractId                Int?
  contract                  Contract?                @relation("Attachment_contractId", fields: [firmId, contractId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  expenseId                 Int?
  expense                   Expense?                 @relation("Attachment_expenseId", fields: [firmId, expenseId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  receivableId              Int?
  receivable                Receivable?              @relation("Attachment_receivableId", fields: [firmId, receivableId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  payableId                 Int?
  payable                   Payable?                 @relation("Attachment_payableId", fields: [firmId, payableId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  receiptId                 Int?
  receipt                   Receipt?                 @relation("Attachment_receiptId", fields: [firmId, receiptId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  paymentId                 Int?
  payment                   Payment?                 @relation("Attachment_paymentId", fields: [firmId, paymentId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)
  remunerationCalculationId Int?
  remunerationCalculation   RemunerationCalculation? @relation("Attachment_remunerationCalculationId", fields: [firmId, remunerationCalculationId], references: [firmId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([firmId, id])
  @@index([firmId])
  @@index([typeId])
  @@index([personId])
  @@index([contractId])
  @@index([expenseId])
  @@index([receivableId])
  @@index([payableId])
  @@index([receiptId])
  @@index([paymentId])
  @@index([remunerationCalculationId])
  @@map("attachments")
}

