import * as React from \"react\";
import { AttachmentSectionFallback } from \"@/features/attachments\";
import { EntityActions } from \"@/shared/components/entity-actions\";
import { EntityDetail } from \"@/shared/components/entity-detail\";
import { NavigationLink } from \"@/shared/components/navigation-link\";
import { Skeleton } from \"@/shared/components/ui\";
import { SensitiveValue } from \"@/shared/components/value-visibility\";
import { formatter } from \"@/shared/lib/formatter\";
import type { EntityId } from \"@/shared/schemas/entity\";
import { hasPermission, useLoggedUserSession } from \"@/shared/session\";
import type { OverlayState } from \"@/shared/types/overlay\";
import { useExpense } from \"../../hooks/use-data\";
import { expenseSearchSchema } from \"../../schemas/search\";
import { getExpenseLifecycleActions } from \"../../utils/lifecycle-actions\";
import { ExpenseOverview } from \"./overview\";

interface ExpenseDetailsProps {
	canManageLifecycle?: boolean;
	id: EntityId;
	onDelete?: (id: EntityId) => void;
	onEdit?: (id: EntityId) => void;
	onRestore?: (id: EntityId) => void;
	state: OverlayState;
}

export const ExpenseDetails = ({
	canManageLifecycle = false,
	id,
	onDelete,
	onEdit,
	onRestore,
	state,
}: ExpenseDetailsProps) => {
	return (
		<EntityDetail.Root key={id} state={state}>
			<React.Suspense fallback={<ExpenseDetailsFallback />}>
				<ExpenseDetailsContent
					canManageLifecycle={canManageLifecycle}
					id={id}
					onDelete={onDelete}
					onEdit={onEdit}
					onRestore={onRestore}
				/>
			</React.Suspense>
		</EntityDetail.Root>
	);
};

interface ExpenseDetailsContentProps {
	canManageLifecycle: boolean;
	id: EntityId;
	onDelete?: (id: EntityId) => void;
	onEdit?: (id: EntityId) => void;
	onRestore?: (id: EntityId) => void;
}

function ExpenseDetailsContent({
	canManageLifecycle,
	id,
	onDelete,
	onEdit,
	onRestore,
}: ExpenseDetailsContentProps) {
	const currentSearch = useSearch({ strict: false });
	const { expense } = useExpense(id);
	const actions = getExpenseLifecycleActions({
		canManageLifecycle,
		isSoftDeleted: expense.isSoftDeleted,
	});

	const workspaceLink = (
		<NavigationLink
			to=\"/despesas/$expenseId\"
			params={{ expenseId: String(id) }}
			search={{
				tab: \"overview\",
				returnTo: expenseSearchSchema.parse(currentSearch),
			}}
			className=\"inline-flex items-center gap-1 text-xs font-medium\"
		>
			Abrir página
		</NavigationLink>
	);

	return (
		<EntityDetail.Content>
			<EntityDetail.Header className=\"flex-row items-center justify-between gap-3\">
				<EntityDetail.Title className=\"min-w-0 flex-1 truncate\">
					{expense.supplierName} •{\" \"}
					<SensitiveValue>
						{formatter.currency(expense.negotiatedAmount)}
					</SensitiveValue>
				</EntityDetail.Title>
				<div className=\"hidden shrink-0 sm:block\">{workspaceLink}</div>
				<EntityActions
					viewPermission=\"org:expenses:read\"
					editPermission=\"org:expenses:update\"
					restorePermission=\"org:expenses:restore\"
					deletePermission=\"org:expenses:delete\"
					canView={false}
					canEdit={actions.canEdit}
					canRestore={actions.canRestore}
					canDelete={actions.canDelete}
					onEdit={onEdit ? () => onEdit(id) : undefined}
					onRestore={onRestore ? () => onRestore(id) : undefined}
					onDelete={onDelete ? () => onDelete(id) : undefined}
				/>
			</EntityDetail.Header>
			<EntityDetail.Body>
				<div className=\"sm:hidden\">{workspaceLink}</div>
				<ExpenseOverview id={id} />
			</EntityDetail.Body>
			<EntityDetail.Footer />
		</EntityDetail.Content>
	);
}

function ExpenseDetailsFallback() {
	const session = useLoggedUserSession();

	return (
		<EntityDetail.Content>
			<EntityDetail.Header className=\"flex-row items-center justify-between gap-3\">
				<EntityDetail.Title className=\"min-w-0 flex-1 truncate\">
					<Skeleton className=\"h-6 w-48\" />
				</EntityDetail.Title>
				<Skeleton className=\"h-8 w-20 shrink-0\" />
			</EntityDetail.Header>
			<EntityDetail.Body>
				<div className=\"flex flex-col gap-3\">
					<div className=\"grid grid-cols-2 gap-4\">
						<Skeleton className=\"h-10 w-full\" />
						<Skeleton className=\"h-10 w-full\" />
					</div>
					<EntityDetail.Separator />
					<EntityDetail.Section title=\"Observações\">
						<Skeleton className=\"h-16 w-full\" />
					</EntityDetail.Section>
					{hasPermission(session, \"org:attachments:read\") ? (
						<>
							<EntityDetail.Separator />
							<AttachmentSectionFallback />
						</>
					) : null}
					<EntityDetail.Separator />
					<EntityDetail.Section title=\"Registro\">
						<div className=\"grid grid-cols-2 gap-4\">
							<Skeleton className=\"h-10 w-full\" />
							<Skeleton className=\"h-10 w-full\" />
						</div>
					</EntityDetail.Section>
				</div>
			</EntityDetail.Body>
			<EntityDetail.Footer />
		</EntityDetail.Content>
	);
}
import * as React from \"react\";
import { AttachmentSection } from \"@/features/attachments\";
import {
	type DetailFieldItem,
	EntityDetail,
} from \"@/shared/components/entity-detail\";
import { FormSection } from \"@/shared/components/form-section\";
import { SensitiveValue } from \"@/shared/components/value-visibility\";
import { formatter } from \"@/shared/lib/formatter\";
import type { EntityId } from \"@/shared/schemas/entity\";
import { hasPermission, useLoggedUserSession } from \"@/shared/session\";
import { useExpense } from \"../../hooks/use-data\";

interface ExpenseOverviewProps {
	section?: \"all\" | \"overview\";
	id: EntityId;
	includeAttachments?: boolean;
}

export function ExpenseOverview({
	id,
	includeAttachments = true,
	section = \"all\",
}: ExpenseOverviewProps) {
	const { expense } = useExpense(id);
	const session = useLoggedUserSession();

	const generalInfo = React.useMemo<DetailFieldItem[]>(
		() => [
			{
				term: \"Fornecedor\",
				definition: expense.supplierName,
			},
			{
				term: \"Valor Negociado\",
				definition: (
					<SensitiveValue>
						{formatter.currency(expense.negotiatedAmount)}
					</SensitiveValue>
				),
			},
			{
				term: \"Status\",
				definition: expense.isActive ? \"Ativo\" : \"Inativo\",
			},
		],
		[expense],
	);

	const registerInfo = React.useMemo<DetailFieldItem[]>(
		() => [
			{ term: \"Criado em\", definition: formatter.date(expense.createdAt) },
			{
				term: \"Atualizado em\",
				definition: expense.updatedAt ? formatter.date(expense.updatedAt) : \"—\",
			},
		],
		[expense],
	);

	if (section === \"overview\") {
		return (
			<div className=\"space-y-6\">
				<FormSection title=\"Dados da despesa\">
					<EntityDetail.Fields
						columns={2}
						items={[
							...generalInfo,
							{
								term: \"Observações\",
								definition: expense.notes?.trim() || \"—\",
								classNames: {
									item: \"col-span-2\",
									definition: \"whitespace-pre-wrap\",
								},
							},
						]}
					/>
				</FormSection>
			</div>
		);
	}

	return (
		<div className=\"flex min-w-0 flex-col gap-3\">
			<EntityDetail.Fields columns={2} items={generalInfo} />
			<EntityDetail.Separator />
			<EntityDetail.Section title=\"Observações\">
				<p className=\"text-sm\">{expense.notes?.trim() || \"—\"}</p>
			</EntityDetail.Section>
			{includeAttachments && hasPermission(session, \"org:attachments:read\") && (
				<>
					<EntityDetail.Separator />
					<AttachmentSection
						canUpload={
							!expense.isSoftDeleted &&
							hasPermission(session, \"org:expenses:update\")
						}
						ownerId={id}
						ownerKind=\"expense\"
					/>
				</>
			)}
			<EntityDetail.Separator />
			<EntityDetail.Section title=\"Registro\">
				<EntityDetail.Fields columns={2} items={registerInfo} />
			</EntityDetail.Section>
		</div>
	);
}
