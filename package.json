{
	"name": "hono-start",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check:ci": "biome check .",
		"verify": "pnpm check:ci && pnpm typecheck && pnpm test && pnpm build",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check --write",
		"post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
		"db:generate": "npx prisma generate",
		"db:push": "npx prisma db push",
		"db:migrate": "npx prisma migrate dev",
		"db:studio": "npx prisma studio",
		"db:seed": "npx prisma db seed",
		"db:reset": "prisma migrate reset --force && prisma generate && prisma db seed"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1159.0",
		"@base-ui/react": "^1.9.0",
		"@clerk/backend": "3.26.1",
		"@clerk/localizations": "^4.24.0",
		"@clerk/tanstack-react-start": "^1.7.5",
		"@clerk/ui": "^1.41.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-form-start": "^1.33.5",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-query-devtools": "^5.104.5",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.3",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/router-plugin": "^1.168.47",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"input-otp": "^1.5.0",
		"lucide-react": "^1.61.0",
		"next-themes": "^0.4.6",
		"nitro": "3.0.260903-beta",
		"pdfjs-dist": "^6.4.299",
		"pdfmake": "^0.3.12",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-aria-components": "^1.22.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"use-debounce": "^10.1.1",
		"use-mask-input": "^3.14.2",
		"vaul": "^1.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@tanstack/devtools-vite": "^0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"dotenv": "^18.0.8",
		"jsdom": "^30.1.3",
		"prisma": "7.10.1",
		"shadcn": "^4.22.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"web-vitals": "^6.2.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		],
		"overrides": {
			"lodash": "4.18.1"
		}
	}
}
